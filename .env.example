# FinSight X — Frontend environment variables
#
# On Vercel: Project → Settings → Environment Variables → add for
# Production (and Preview if desired), then redeploy.

# REQUIRED in production: public origin of the deployed FastAPI backend.
# No trailing slash. Example: https://finsight-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=

# OPTIONAL: only used if you proxy /api/fs through the Next.js server itself
# (self-hosted / Docker deployments). Not needed on Vercel. Default: http://127.0.0.1:8000
# FS_API_ORIGIN=http://127.0.0.1:8000
